# =====================================================================
# InsiEDR Agent Configuration Example
# =====================================================================

# Server endpoint where telemetry payloads will be transmitted
INSIEDR_AGENT_SERVER=http://127.0.0.1:5000/api/logs

# Shared 32-byte AES-256-GCM symmetric key (base64 or hex encoded)
INSIEDR_AES_KEY=e548bcb6e1e7da40ccac2adeba65f34554458de520e9a0780f3a5f04f01a72d7

# Unique identifier for this endpoint (defaults to SASTRA-<hostname> if unset)
INSIEDR_AGENT_ID=SASTRA-WINDOWS-AGENT-01

# Operational Mode (production / evaluation / debug)
INSIEDR_AGENT_MODE=production

# Network & TLS Settings
INSIEDR_ALLOW_INSECURE_HTTP=true
INSIEDR_REQUIRE_HTTPS=false
INSIEDR_DISABLE_TLS_VERIFY=true

# Telemetry Collection Interval (in seconds)
INSIEDR_COLLECTION_INTERVAL_SECONDS=10

# Comma-separated list of enabled collector modules
INSIEDR_ENABLED_COLLECTORS=logon,file,device,http,process,keystroke-collector,decoy-monitor,clipboard-monitor,network-monitor

# Local Spooling & Resilient Queue Settings
INSIEDR_MAX_QUEUE_ITEMS=1000
INSIEDR_MAX_QUEUE_BYTES=104857600
INSIEDR_MAX_QUEUE_AGE_DAYS=30
INSIEDR_REPLAY_WINDOW_HOURS=720

# Logging Configuration (DEBUG, INFO, WARNING, ERROR)
INSIEDR_LOG_LEVEL=INFO
